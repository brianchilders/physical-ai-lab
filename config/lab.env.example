# Stable lab defaults for the Physical AI Lab.
#
# Precedence:
# shell environment > local .env > .env.example > this file

LAB_HOSTNAME=blackmagic
ISAAC_STORAGE_ROOT=/mnt/nvme/isaac
ISAAC_SIM_REGISTRY=nvcr.io
ISAAC_SIM_REPOSITORY=nvidia/isaac-sim
ISAAC_SIM_TAG=6.0.1
DGX_SPARK_ENABLED=false
JETSON_ENABLED=false
ROS2_ENABLED=false

