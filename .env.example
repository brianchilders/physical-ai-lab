# Runtime-specific Isaac Sim defaults.
#
# Stable lab defaults live in config/lab.env.example.
# GUI session variables are intentionally omitted here so headless validation
# and headless launch paths do not inherit fake desktop settings.
#
# Precedence:
# shell environment > local .env > this file > config/lab.env.example

ISAAC_SIM_NAME=isaac-sim
ISAAC_SIM_UID=1234
ISAAC_SIM_GID=1234

ACCEPT_EULA=Y
PRIVACY_CONSENT=N
PRIVACY_USERID=

INTERACTIVE_STUDIO_CONTAINER_NAME=interactive-studio
INTERACTIVE_STUDIO_IMAGE_REF=nvcr.io/nvidia/isaac-sim:6.0.1
INTERACTIVE_STUDIO_WORKSPACE_ROOT=/mnt/nvme/isaac/interactive-studio/workspace
INTERACTIVE_STUDIO_HOST_IP=
INTERACTIVE_STUDIO_SIGNAL_PORT=49100
INTERACTIVE_STUDIO_STREAM_PORT=47998

COMPOSE_PROJECT_NAME=isaac
