# Runtime-specific Isaac Sim defaults.
#
# Stable lab defaults live in config/lab.env.example.
#
# Precedence:
# shell environment > local .env > this file > config/lab.env.example

ISAAC_SIM_NAME=isaac-sim
ISAAC_SIM_UID=1234
ISAAC_SIM_GID=1234

ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
PRIVACY_USERID=

ISAACSIM_HOST=127.0.0.1
ISAACSIM_SIGNAL_PORT=49100
ISAACSIM_STREAM_PORT=47998

DISPLAY=:0
XAUTHORITY=$HOME/.Xauthority

COMPOSE_PROJECT_NAME=isaac
